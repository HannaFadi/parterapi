// Cloudflare Worker: statiska filer från repots rot, plus ett litet API
// under /api för bokning och betalning. .assetsignore håller verktyg,
// källkod och konfig utanför publiceringen.
{
  "name": "mariehanna",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-21",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    // /priser serveras från priser.html och /priser.html omdirigeras till /priser
    "html_handling": "auto-trailing-slash",
    // Okända adresser får 404.html med status 404, inte startsidan
    "not_found_handling": "404-page",
    // Bara API:t går via Workern; allt annat serveras direkt som fil
    "run_worker_first": ["/api/*"]
  },
  // Cloudflare skapar DNS-poster och certifikat för domänerna automatiskt
  "routes": [
    { "pattern": "mariehanna.se", "custom_domain": true },
    { "pattern": "www.mariehanna.se", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mariehanna-bokningar",
      "database_id": "7fdaf4db-be7f-41ee-8740-cf64815be5a5"
    }
  ],
  // Bokningsmejl. Utan registrerad avsändardomän går det bara att skicka
  // till verifierade adresser (Marie); mejlet till paret skickas när
  // mariehanna.se är registrerad för Email Sending.
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    "SAJT_URL": "https://mariehanna.se",
    "PRIS_ORE": "45000",
    "MARIE_EPOST": "mariecuchet@gmail.com",
    "AVSANDARE": "bokning@mariehanna.se"
  },
  "observability": { "enabled": true }
}
