#!/usr/bin/env python3
"""Lokal förhandsvisning som beter sig som Cloudflare Pages.

Sajten publiceras utan .html i adresserna, så en vanlig
`python3 -m http.server` ger 404 på varje länk. Den här servern gör
samma tre saker som Pages: serverar /sida från sida.html, flyttar
/sida.html till /sida, och visar 404.html med rätt statuskod.

    bin/forhandsvisa          # http://127.0.0.1:4173
    bin/forhandsvisa 8080
"""
import http.server
import os
import posixpath
import sys
import urllib.parse

ROT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))


class Pages(http.server.SimpleHTTPRequestHandler):
    def __init__(self, *a, **kw):
        super().__init__(*a, directory=ROT, **kw)

    def send_head(self):
        sokvag = urllib.parse.urlsplit(self.path).path

        # /sida.html -> /sida, precis som Pages gör (308)
        if sokvag.endswith(".html") and posixpath.basename(sokvag) != "404.html":
            mal = sokvag[: -len(".html")]
            if posixpath.basename(mal) == "index":
                mal = posixpath.dirname(mal) + "/"
            self.send_response(308)
            self.send_header("Location", mal)
            self.end_headers()
            return None

        # /sida -> sida.html om filen finns
        if not sokvag.endswith("/"):
            pa_disk = os.path.join(ROT, sokvag.lstrip("/"))
            if not os.path.exists(pa_disk) and os.path.isfile(pa_disk + ".html"):
                self.path = sokvag + ".html"

        if os.path.exists(os.path.join(ROT, urllib.parse.urlsplit(self.path).path.lstrip("/"))):
            return super().send_head()

        return self.fel_404()

    def fel_404(self):
        sida = os.path.join(ROT, "404.html")
        if not os.path.isfile(sida):
            self.send_error(404)
            return None
        kropp = open(sida, "rb").read()
        self.send_response(404)
        self.send_header("Content-Type", "text/html; charset=utf-8")
        self.send_header("Content-Length", str(len(kropp)))
        self.end_headers()
        import io
        return io.BytesIO(kropp)

    def log_message(self, fmt, *args):
        sys.stderr.write("%s\n" % (fmt % args))


if __name__ == "__main__":
    port = int(sys.argv[1]) if len(sys.argv) > 1 else 4173
    print(f"Förhandsvisning: http://127.0.0.1:{port}  (Ctrl+C avslutar)")
    http.server.ThreadingHTTPServer(("127.0.0.1", port), Pages).serve_forever()
